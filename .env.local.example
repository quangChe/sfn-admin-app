# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── better-auth ──────────────────────────────────────────────────────────────
# Base URL of the app — used by better-auth to construct OAuth callback URLs.
# In production set to your actual domain (e.g. https://admin.fashionica.com).
BETTER_AUTH_URL=http://localhost:3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Neon connection string — get from neon.tech dashboard
DATABASE_URL=

# ─── Shopify ──────────────────────────────────────────────────────────────────
# From Shopify Admin → Apps → Develop apps → Create an app → API credentials
# Required scopes: read_orders, read_products, read_customers, read_reports, read_files
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2026-01

# ─── Pusher Channels ──────────────────────────────────────────────────────────
# From pusher.com → Your App → App Keys
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
